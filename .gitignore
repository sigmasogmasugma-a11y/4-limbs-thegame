*.pdb
*.mdb
*.opendb
*.VC.db

# Unity crash / debug files
sysinfo.txt
crashlytics-build.properties
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Addressables / Burst
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
*_BurstDebugInformation_DoNotShip/

# OS junk
.DS_Store
Thumbs.db
